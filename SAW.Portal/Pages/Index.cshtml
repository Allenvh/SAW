@page
@model IndexModel
<h1>SAW Portal</h1>
<p>User: @Model.SourceUser</p>
<ul>
@foreach(var app in Model.VisibleApps){
<li>@app.Name - @app.Url <form method="post" asp-page-handler="Launch"><input type="hidden" name="appId" value="@app.Id" /><button>Launch</button></form></li>
}
</ul>
<h2>Sessions</h2>
<ul>
@foreach(var s in Model.Sessions){<li>@s.SessionId @s.AppId @s.Url <form method="post" asp-page-handler="Stop"><input type="hidden" name="id" value="@s.SessionId"/><button>Stop</button></form></li>}
</ul>
