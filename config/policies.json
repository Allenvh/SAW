{
  "globalDefaults": {
    "flags": {
      "AllowFileUpload": false,
      "AllowFileDownload": false,
      "AllowPrinting": false,
      "AllowClipboardIntoSession": true,
      "AllowClipboardOutOfSession": false,
      "AllowDragDrop": false,
      "AllowDevTools": false,
      "AllowBrowserExtensions": false,
      "AllowWebcam": false,
      "AllowMicrophone": false,
      "AllowAudio": false,
      "EnableWatermark": true,
      "EnableKioskMode": true,
      "EphemeralProfile": true,
      "PersistentProfile": false,
      "RecordSessionMetadata": true,
      "RecordSessionVideo": false,
      "BlockDownloadsAtBrowser": true,
      "RedirectDownloadsToStaging": false
    },
    "sessionTimeoutMinutes": 30,
    "requireKerberos": true,
    "allowNtlmFallback": false
  },
  "groupPolicies": {
    "SAW_Admins": { "flags": { "AllowDevTools": true, "EnableKioskMode": false, "PersistentProfile": true } },
    "SAW_FileUpload_Allowed": { "flags": { "AllowFileUpload": true } },
    "SAW_FileDownload_Allowed": { "flags": { "AllowFileDownload": true, "BlockDownloadsAtBrowser": false } },
    "SAW_Print_Allowed": { "flags": { "AllowPrinting": true } },
    "SAW_ClipboardOut_Allowed": { "flags": { "AllowClipboardOutOfSession": true } }
  },
  "appPolicies": {
    "app1": { "requireKerberos": true, "allowNtlmFallback": false },
    "app2": { "requireKerberos": true, "allowNtlmFallback": false }
  }
}
